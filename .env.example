DATABASE_URL=postgresql://draft1:draft1_dev_password@db:5432/draft1

# Give each concurrently running worktree a different host port (for example, 5433).
# Containers still connect to PostgreSQL on db:5432 through the Compose network.
DB_HOST_PORT=5432

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads

# Swap this once the research-agent OCR comparison picks a model
OCR_MODEL_BACKEND=mock

REVIEW_CONFIDENCE_THRESHOLD=0.85
