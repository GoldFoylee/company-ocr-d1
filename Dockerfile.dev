FROM python:3.11-slim

# Match the production runtime libraries while keeping developer-only Python
# packages out of the production image. libgomp1 (GNU OpenMP) is required by
# paddlepaddle's compute kernels -- without it, `import paddle` fails with
# "ImportError: libgomp.so.1: cannot open shared object file".
# LibreOffice Calc recalculates the generated workbook during export validation.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libreoffice-calc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

COPY . .

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
